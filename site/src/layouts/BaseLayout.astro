---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import WhatsAppButton from '~/components/WhatsAppButton.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { abs, BRAND, GOOGLE_SITE_VERIFICATION } from '~/lib/site';
import type { Crumb } from '~/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Site-root path with a trailing slash, e.g. "/10x13-poly-mailers/" */
  path: string;
  /** Absolute or site-root URL of the social preview image. */
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Serialized JSON-LD graph. */
  schema?: string;
  crumbs?: readonly Crumb[];
  /** Absolute URL of the LCP image, preloaded when supplied. */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  noindex = false,
  schema,
  crumbs,
  preloadImage,
  bodyClass = '',
} = Astro.props;

const canonical = abs(path);
const socialImage = ogImage ? (ogImage.startsWith('http') ? ogImage : abs(ogImage)) : undefined;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <meta name="theme-color" content="#0d1116" />
    {/*
      favicon.ico is listed first and is not optional. Google fetches
      /favicon.ico by convention when deciding what to show beside a search
      result, and an SVG-only site tends to get the generic globe instead.
      Browsers that prefer the SVG still take it — they read the whole list.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.imagesrcset}
          imagesizes={preloadImage.imagesizes}
          fetchpriority="high"
        />
      )
    }

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    {crumbs && crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Scroll reveal. One observer, no layout reads, unhooks as it goes.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduce.matches || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    {/*
      Live chat, served from the ZeeOps dashboard under the `thepolymailers`
      site id. `async` rather than `defer` because it has no dependency on the
      DOM being parsed and nothing on the page waits for it.

      It is the only third-party request the site makes, and it is the reason
      chat.zeeops.dev appears in script-src, connect-src and img-src in
      vercel.json — the CSP permits no other external origin, so adding any
      further third-party script is a deliberate act rather than an accident.
    */}
    <script async src="https://chat.zeeops.dev/widget.js?siteId=thepolymailers"></script>
  </body>
</html>
