---
/**
 * Pseudo-3D mailer figure for the hero.
 *
 * Pure inline SVG plus CSS transforms — no library, no canvas, no image
 * request, and nothing that can shift layout because the aspect ratio is fixed.
 * The colour swatches below it drive a CSS custom property, so switching colour
 * is a repaint rather than a re-render.
 */

const swatches = [
  { id: 'ink', label: 'Matte black', body: '#1b1f26', shade: '#0e1116', tint: '#2a303a', ink: '#f5f6f8' },
  { id: 'blush', label: 'Blush pink', body: '#f3c9d2', shade: '#dfa8b5', tint: '#f9dee4', ink: '#4a2732' },
  { id: 'cobalt', label: 'Cobalt blue', body: '#2f52d8', shade: '#2340ad', tint: '#5876e6', ink: '#eef2ff' },
  { id: 'bone', label: 'Bone white', body: '#f2efe8', shade: '#d9d4c8', tint: '#faf8f4', ink: '#2b3038' },
];
---

<figure class="mfig" data-mailer-figure>
  <div class="mfig-stage">
    <svg
      class="mfig-svg"
      viewBox="0 0 420 400"
      role="img"
      aria-label="Illustration of a poly mailer shown at an angle, with a sealed flap, a printed brand mark and an address label"
    >
      <defs>
        <linearGradient id="mf-face" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--mf-tint)"></stop>
          <stop offset="55%" stop-color="var(--mf-body)"></stop>
          <stop offset="100%" stop-color="var(--mf-shade)"></stop>
        </linearGradient>
        <linearGradient id="mf-flap" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--mf-shade)"></stop>
          <stop offset="100%" stop-color="var(--mf-body)"></stop>
        </linearGradient>
        <filter id="mf-shadow" x="-30%" y="-20%" width="170%" height="150%">
          <feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#0d1116" flood-opacity="0.22"></feDropShadow>
        </filter>
      </defs>

      <g filter="url(#mf-shadow)">
        <!-- Body of the mailer, drawn as a parallelogram to read as depth -->
        <path
          class="mf-body"
          d="M62 118 L300 62 L372 268 L134 338 Z"
          fill="url(#mf-face)"
        ></path>

        <!-- Sealed flap along the top edge -->
        <path
          class="mf-flap"
          d="M62 118 L300 62 L312 100 L74 154 Z"
          fill="url(#mf-flap)"
          opacity="0.92"
        ></path>

        <!-- Adhesive strip highlight -->
        <path
          d="M70 138 L303 82"
          stroke="var(--mf-ink)"
          stroke-opacity="0.28"
          stroke-width="3"
          stroke-dasharray="9 7"
          stroke-linecap="round"
          fill="none"></path>

        <!-- Printed brand mark -->
        <g class="mf-print" opacity="0.9">
          <rect x="118" y="176" width="86" height="10" rx="5" fill="var(--mf-ink)" opacity="0.95"></rect>
          <rect x="118" y="196" width="132" height="10" rx="5" fill="var(--mf-ink)" opacity="0.6"></rect>
          <rect x="118" y="216" width="58" height="10" rx="5" fill="var(--mf-ink)" opacity="0.35"></rect>
        </g>

        <!-- Address label, deliberately on a clear panel -->
        <g class="mf-label">
          <rect x="222" y="228" width="104" height="62" rx="3" fill="#ffffff" opacity="0.96" transform="rotate(-13 274 259)"></rect>
          <g transform="rotate(-13 274 259)" opacity="0.55">
            <rect x="232" y="240" width="60" height="4" rx="2" fill="#0d1116"></rect>
            <rect x="232" y="250" width="78" height="4" rx="2" fill="#0d1116"></rect>
            <rect x="232" y="262" width="46" height="4" rx="2" fill="#0d1116"></rect>
            <rect x="232" y="274" width="84" height="8" rx="1" fill="#0d1116"></rect>
          </g>
        </g>

        <!-- Soft fold highlight so the face does not read completely flat -->
        <path d="M104 152 L340 208" stroke="#ffffff" stroke-opacity="0.13" stroke-width="14" fill="none"></path>
      </g>
    </svg>
  </div>

  <figcaption class="mfig-controls">
    <span class="mfig-label" id="mfig-label">Film colour</span>
    <div class="mfig-swatches" role="group" aria-labelledby="mfig-label">
      {
        swatches.map((s, i) => (
          <button
            type="button"
            class="mfig-swatch"
            data-swatch
            data-body={s.body}
            data-shade={s.shade}
            data-tint={s.tint}
            data-ink={s.ink}
            aria-pressed={i === 0 ? 'true' : 'false'}
            style={`--sw:${s.body}`}
          >
            <span class="visually-hidden">{s.label}</span>
          </button>
        ))
      }
    </div>
    <span class="mfig-note" data-swatch-name>Matte black</span>
  </figcaption>
</figure>

<style>
  .mfig {
    margin: 0;
    --mf-body: #1b1f26;
    --mf-shade: #0e1116;
    --mf-tint: #2a303a;
    --mf-ink: #f5f6f8;
  }

  .mfig-stage {
    /* Fixed ratio: nothing here can move the hero once it paints. */
    aspect-ratio: 21 / 20;
    display: grid;
    place-items: center;
    perspective: 1100px;
    /* The figure is rotated in 3D, so its painted box is wider than its layout
       box. This inset keeps the painted result inside the column. */
    padding-inline: 6%;
  }

  .mfig-svg {
    inline-size: 100%;
    block-size: auto;
    transform: rotateX(5deg) rotateY(-7deg);
    transform-style: preserve-3d;
    transition: transform 900ms var(--ease-out);
  }

  .mf-body,
  .mf-flap,
  .mf-print rect {
    transition: fill 420ms var(--ease);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mfig-stage:hover .mfig-svg { transform: rotateX(2deg) rotateY(-3deg) scale(1.015); }
  }

  .mfig-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.85rem;
    margin-block-start: var(--sp-s);
  }

  .mfig-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .mfig-swatches { display: flex; gap: 0.4rem; }

  .mfig-swatch {
    inline-size: 30px;
    block-size: 30px;
    border-radius: 50%;
    background: var(--sw);
    border: 2px solid var(--paper);
    box-shadow: 0 0 0 1px var(--line-strong);
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .mfig-swatch:hover { transform: scale(1.08); }
  .mfig-swatch[aria-pressed='true'] { box-shadow: 0 0 0 2px var(--accent); }

  .mfig-note { font-size: 0.83rem; color: var(--fg-muted); }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>('[data-mailer-figure]')) {
    const swatches = figure.querySelectorAll<HTMLButtonElement>('[data-swatch]');
    const name = figure.querySelector<HTMLElement>('[data-swatch-name]');

    swatches.forEach((swatch) => {
      swatch.addEventListener('click', () => {
        figure.style.setProperty('--mf-body', swatch.dataset.body ?? '');
        figure.style.setProperty('--mf-shade', swatch.dataset.shade ?? '');
        figure.style.setProperty('--mf-tint', swatch.dataset.tint ?? '');
        figure.style.setProperty('--mf-ink', swatch.dataset.ink ?? '');
        swatches.forEach((s) => s.setAttribute('aria-pressed', String(s === swatch)));
        if (name) name.textContent = swatch.querySelector('span')?.textContent ?? '';
      });
    });
  }
</script>
