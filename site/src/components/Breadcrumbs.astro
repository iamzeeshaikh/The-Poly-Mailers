---
import type { Crumb } from '~/lib/schema';

interface Props {
  crumbs: readonly Crumb[];
}

const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <ol role="list">
      {
        crumbs.map((crumb, i) => (
          <li>
            {i === last ? (
              <span aria-current="page">{crumb.name}</span>
            ) : (
              <>
                <a href={crumb.href}>{crumb.name}</a>
                <svg width="6" height="9" viewBox="0 0 6 9" aria-hidden="true">
                  <path d="M1 1l3.5 3.5L1 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    border-block-end: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.42rem;
    list-style: none;
    margin: 0;
    padding-block: 0.62rem;
    font-size: 0.82rem;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--fg-subtle);
  }

  a { color: var(--fg-muted); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }

  [aria-current='page'] {
    color: var(--fg);
    font-weight: 550;
  }
</style>
