---
/** Product-page order box. One starting price for every mailer: $0.30 per unit
 *  (PRICING.unit, the same figure as the Offer and the Merchant feed), in runs
 *  of 100, shipped to the four markets we serve. "Add to order" keeps the line
 *  in localStorage (public/scripts/order.js) and opens /checkout/, where the
 *  delivery address and payment method are taken; without JavaScript the form
 *  still lands on /checkout/?add=<slug>&qty=<n>. No pack total is shown here;
 *  the real bill is on /checkout/. */
import { UNIT_PRICE, UNIT_PRICE_TEXT, PACK_QTY, MAX_QTY, QUANTITIES, PAYMENT_LINE } from '~/lib/order';
import PayBadge from './PayBadge.astro';
import TrustSeals from './TrustSeals.astro';
interface Props { product: string; slug: string; quoteId: string; }
const { product, slug, quoteId } = Astro.props;
const formId = `order-${slug}`;
---
<div class="orderbox" id="order">
  <p class="orderbox-eyebrow">Order online</p>
  <h2 class="orderbox-h" id={`${formId}-heading`}>Order {product.toLowerCase()}</h2>
  <p class="orderbox-from"><strong>Starting from {UNIT_PRICE_TEXT} per unit</strong></p>
  <p class="orderbox-sub">
    Plain or printed with your artwork, in runs of {PACK_QTY}. Shipped to the United States,
    United Kingdom, Canada and Australia.
  </p>
  <form method="get" action="/checkout/" data-order-box data-slug={slug} data-unit={UNIT_PRICE}
    aria-labelledby={`${formId}-heading`}>
    <input type="hidden" name="add" value={slug} />
    <p class="field">
      <label for={`${formId}-quantity`}>Quantity <span class="req" aria-hidden="true">*</span></label>
      <select id={`${formId}-quantity`} name="qty" required data-order-qty>
        {QUANTITIES.map((qty) => (
          <option value={qty} selected={qty === 500}>{qty.toLocaleString('en-US')} units</option>
        ))}
      </select>
    </p>
    <button type="submit" class="btn btn-lg orderbox-btn" data-order-add>Add to order</button>
    <p class="orderbox-hint">Review your order and add the delivery address on the next page. No payment is taken online.</p>
    <TrustSeals class="seals-box" />
    <PayBadge />
    <ol class="orderbox-steps">
      <li>Add the mailers you need, then check out with your delivery address.</li>
      <li>We email a free digital proof. Nothing runs before you approve it.</li>
      <li>{PAYMENT_LINE}</li>
      <li>Shipping cost and the schedule are confirmed with the proof, before anything is charged.</li>
    </ol>
    <p class="orderbox-note">
      See our <a href="/shipping-and-delivery/">shipping and delivery</a> page and the
      <a href="/custom-order-policy/">custom order policy</a>: an order that does not match the
      approved proof or specification is ours to put right. More than {MAX_QTY.toLocaleString('en-US')} units,
      or a size we have not quoted before? <a href={`#${quoteId}`}>Request a quotation</a> below.
    </p>
  </form>
</div>
<script src="/scripts/order.js" defer is:inline></script>
