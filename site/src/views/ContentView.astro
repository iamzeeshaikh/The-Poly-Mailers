---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Blocks from '~/components/Blocks.astro';
import FaqList from '~/components/FaqList.astro';
import RelatedLinks from '~/components/RelatedLinks.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import CtaBand from '~/components/CtaBand.astro';
import { breadcrumbs, faqPage, graph, webPage, type Crumb, type Json } from '~/lib/schema';
import type { ContentPage } from '~/data/types';

interface Props {
  page: ContentPage;
  path: string;
  crumbs: readonly Crumb[];
  /** Schema.org WebPage subtype where the content justifies one. */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  /** Extra JSON-LD nodes appended to the graph. */
  extraSchema?: readonly (Json | null)[];
  /** Renders a quote form under the intro. Commercial pages only. */
  quoteForm?: { preset?: string; heading: string; intro: string };
  noindex?: boolean;
  /** Rendered between the intro and the blocks. */
  eyebrow?: string;
}

const {
  page,
  path,
  crumbs,
  pageType = 'WebPage',
  extraSchema = [],
  quoteForm,
  noindex = false,
  eyebrow,
} = Astro.props;

const schema = graph([
  webPage({
    path,
    name: page.h1,
    description: page.description,
    type: pageType,
    hasBreadcrumb: crumbs.length > 1,
  }),
  crumbs.length > 1 ? breadcrumbs(crumbs) : null,
  page.faqs?.length ? faqPage(path, page.faqs) : null,
  ...extraSchema,
]);
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={path}
  schema={schema}
  crumbs={crumbs}
  noindex={noindex}
>
  <article>
    <header class="wrap page-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{page.h1}</h1>
      {page.intro.map((p, i) => <p class={i === 0 ? 'lede' : 'head-p'}>{p}</p>)}
    </header>

    {
      quoteForm && (
        <div class="wrap section-tight">
          <QuoteForm
            source={path}
            compact
            preset={quoteForm.preset}
            id={`quote-${page.slug}`}
            heading={quoteForm.heading}
            intro={quoteForm.intro}
          />
        </div>
      )
    }

    <div class="wrap section-tight">
      <Blocks blocks={page.blocks} />
    </div>

    <slot />

    {
      page.faqs && page.faqs.length > 0 && (
        <div class="wrap section-tight">
          <FaqList
            faqs={page.faqs}
            heading={`Questions about ${page.name.toLowerCase()}`}
            id={`faq-${page.slug}`}
          />
        </div>
      )
    }

    {
      page.related && page.related.length > 0 && (
        <div class="wrap section-tight">
          <RelatedLinks links={page.related} heading="Continue from here" />
        </div>
      )
    }

    {
      page.cta && (
        <div class="wrap section-tight">
          <CtaBand
            heading={page.cta.heading}
            body={page.cta.body}
            buttonLabel={page.cta.buttonLabel}
            whatsappMessage={page.whatsapp}
          />
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--sp-xl) var(--sp-s);
    max-width: 62rem;
  }

  .page-head { min-width: 0; }
  .page-head h1 { margin-block: 0.6rem 1rem; max-width: 18ch; }
  .page-head .lede { font-size: var(--step-1); }
  .head-p { margin-block-start: 0.9rem; color: var(--fg-muted); max-width: 60ch; }
</style>
